{
  "manifest_version": 3,
  "name": "Farm RPG Quest Tracker helper",
  "version": "1.0.0",
  "description": "Shows how many of each item your active quests need on Farm RPG's Inventory, item and Craftworks pages, and keeps your tracker's inventory up to date.",
  "key": "",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://vxpumllfhlzpnveulojg.supabase.co/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://farmrpg.com/*", "https://www.farmrpg.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
